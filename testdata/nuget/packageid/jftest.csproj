  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>JohnsonControls.jftest</AssemblyName>
    <PackageId>JohnsonControls.jftest.Package</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="11.0.2" />
  </ItemGroup>
</Project>
